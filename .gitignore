/target
node_modules/
package-lock.json
tests/corpus/contracts/*/target
tests/corpus/contracts/*/Cargo.lock
# Single target directory shared by every corpus contract, so the Soroban SDK
# is compiled once rather than once per contract. See real_world_corpus.rs.
tests/corpus/.shared-target
# Build output from the dylint test fixtures. These were committed by mistake;
# their nested `dylint/target/.../incremental/...` paths run to ~220 characters,
# which exceeds the Windows MAX_PATH limit and makes `actions/checkout` fail
# outright on windows-latest before any build step runs.
soroban_cost_lints/test_fixtures/*/target/
# Same rationale for the workspace-root fixtures driven through the CLI:
# `format_contracts.rs` runs the real binary in `test_fixtures/smoke_test`,
# which builds its own `target/` and `Cargo.lock` that must not be committed.
test_fixtures/*/target/
test_fixtures/*/Cargo.lock
*.rcgu.o
/module.rs
# Local AI assistant configuration
opencode.json
